APPLICATION_PORT=5001

# Fallback relays for references that carry no relay hints (e.g. a bare note1).
NOSTR_RELAYS=wss://relay.formstr.app,wss://relay.damus.io,wss://relay.primal.net,wss://nos.lol

# How long to wait for a relay lookup before giving up, in milliseconds.
NOSTR_FETCH_TIMEOUT_MS=10000

# Base URL of the live pollerama app. Pollerama isn't self-hosted, so preview
# `url`s and the /open/:identifier redirect point here.
POLLERAMA_URL=https://pollerama.fun
